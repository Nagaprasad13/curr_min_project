# Copy to backend/.env and set your local values.
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/hospital_referral?retryWrites=true&w=majority
JWT_SECRET=replace_with_a_secure_random_secret
JWT_EXPIRES_IN=1h
ML_SERVICE_URL=http://localhost:8000
